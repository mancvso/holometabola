-- #################################
-- :TIERRA - 142cps
-- ##################################

hush

do
  resetCycles
  hush
  setcps (142/60/4)
  -- 8% - gentler this time
  a3 $ layer[density 1, density 0.125, (# freq 128), (# freq 256), (# freq 512)] $ stack [
    density 0.5 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[bd bd]" # gain 0.9,
          striate 2 $ n (run 3) # s "[~ [vt]]" # gain 0.8 # freq 128
        ]
      ] # stretch 0.8
    ] # freq 972 # cutoff 4000 # legato 2 # speed 4 # stretch 0.1 # gain 1 # overgain 1.8

do
  --d6 $ slow 4 $ s "[~ ed0:3] [bass0:3 ~ <bass0:3 909:3> [bass0:3 ~ <bass0:2 909:3> ~]]/4 bass0:2 techno:6 ~" # cutoff (range 500 5000 $ cF 0.8 "12")
  -- b3 $ density 0.25 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, [bd:4(6, 8, 2)]/2, gabba:4(2, 6, 2)>" # cutoff 120 # room 0.95 # resonance 0.04 # overgain 0.1
  b1 $ density 0.25 $ s "<909:4(4, 8), [~ ~ ~ 909:4(6, 6, 2)], bd:4(3,8), gabba:4(2, 6, 2)>" # hcutoff 800 # cutoff 400 # room 0.2 # gain 0.8
  --let patt = "<[sd:3 sd:4], [sd:2 sd:2 sd:4 sd:2]> <[sd <uxay:3, bd:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, bd:2*2>]"
  let patt = "<[ed0:3 [ed0:4 ~ uxay:9 [ed0:4 ed0:4]]], [ed0:1 [ed0:1(8, 16)]]> ed0:1 [ed0:6 [ed0:8 cre:12]]" -- <[sd <uxay:3, ed0:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, ed0:2*2>]"
  let shape = "1 [1 ~ 1] [1 1] [1 0 0 1]"
  b2 $ layer[density 0.5, density 0.125] $ every 16 (stutter 2 0.2) $ struct shape $ s patt # cutoff 3500 # gain 1 # gain 0.85 # nudge 4
  -- heart
  l3 $ every 4 (density 2 . (#attack 0.8) ) $ density 0.125 $ layer [every 8 (stut 2 0.5 0.5 . density 2), id, slow 8, fast 2] $ slowcat [
      s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
      stack [
        s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        s "~ ~ ~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      stack [
        s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      stack [
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        s "~ ~ ~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
      s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
    ] # gain 0.7 # stretch 0.8 # room 0.6 # cutoff 2000 # begin (slow 13 $ range 0 0.9 sine) # sustain 4 # cut 3

do -- landing
  -- heart
  l1 $ density 0.5 $ striate 4 $ slow 8 $ layer [id, slow 8, fast 2] $ slowcat [
    s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
    s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
    s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
    s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
    ] # gain 0.7 # stretch 0.8 # room 1 # hcutoff 60
  b3 $ stack [
    slow 4 $ s "<909(4, 4), 909:4(2, 4, 5), 909:5(2, 4), 909:2(1, 4, 2)> bd:2 909:3 bd:3" # gain 0.7 # orbit 0,
    s "<bass0:5(2, 4, 0), 909:2(1, 4, 2)>" # gain 0.5,
    slowcat [
    s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3*4>" # gain 0.8,
    s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.6,
    s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.9
    ],
    slow 4 $ s "<bd:2(12, 16, 2), [ ~ ~ ~ [909:2]]>"
    ] # cutoff (range 500 1000 $ sine) # gain 0.8
  b4 $ slow 4 $ slowcat [
    density 2 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(3, 6, 2)>",
    density 1 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(3, 6, 2)>",
    s "<gabba:4(4, 6)>",
    density 1 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(3, 6, 2)>"
    ] # freq 128 # resonance 0.2 # room 1 # cutoff 60

do
  l1 $ density 0.5 $ striate 4 $ slow 8 $ layer [id, slow 8, fast 8 . (#attack 0.05)] $ slowcat [
      s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
      s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
      s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
      s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
      ] # gain 0.7 # stretch 0.8 # room 1 # hcutoff 60
  -- glacial ray
  l6 $ struct "[1 1 0] 0 [1 1 1] 0" $ layer[slow 8, (#freq 2000), density 0.25, every 4 (fast 2  . (# distort saw) ) . (#amp 0.8) . (# hcutoff 400)] $ slowcat [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3>" # gain 0.6,
        stack [
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        slow 2 $ s "~ <outdoor:1, bd:2> <outdoor:2, bd*4> <outdoor:3, bd:3>" # gain 0.9,
        density 0.125 $ slow 2 $ s "~ ~ <outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3>" # gain 0.9
        ],
        stack [
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        slow 2 $ s "~ <outdoor:1, bd:2(4, 8)> <outdoor:2(2, 8), bd(2, 8)> <outdoor:3, bd:3>" # gain 0.9
        ],
        stack [
        slow 2 $ s "~ <outdoor:1, bd:2> <outdoor:2, bd*4> <outdoor:3, bd:3>" # gain 0.9,
        density 0.125 $ slow 2 $ s "~ ~ <outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3>" # gain 0.9
        ],
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.5 # freq 100
    ]
    # freq 8580
    # cutoff 1200
    # stretch 0.3
    # gain 0.6
    # room 3
    # attack 0.05
    # overgain 0.2 # begin (slow 13 $ range 0 0.9 sine) # sustain 2

do
  -- pre heart
  l3 $ density 0.25 $ layer [id, slow 8, fast 2] $ slowcat [
      s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
      s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
      s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
      s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
    ] # gain 0.7 # stretch 0.8 # room 0.8 # cutoff 2000
  b6 $ layer[density 1, density 0.25]
    $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(3, 6, 2)>"
    # gain 0.4
    # room sine
  b5 $ slowcat [
    s "<gabba:2(6, 6, 2), 909:4(4, 8), exxo:5/4, bd:4(3,8), gabba:4(2, 6, 2)>",
    s "<gabba:2(4, 6, 2), 909:4(4, 8), exxo:5/4, bd:4(6,8), gabba:4(2, 6, 2)>",
    s "<gabba:2(3, 6, 2), 909:4(4, 8), exxo:5/4, bd:4(12,8), gabba:4(2, 6, 2)>",
    s "<gabba:2(3, 6, 2), 909:4(4, 8), exxo:5/4, bd:4(1,8), gabba:4(1, 6)>" ]
    # cutoff 2000 # freq 3500 # gain 0.45
  l1 $ layer [density 0.5 . striate 4 . slow 8, slow 8, fast 2] $ slowcat [
    s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
    s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
    s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
    s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
    ] # gain 0.7 # stretch 0.8 # room 1


do -- the good one
  b1 $ layer[density 2 . (# freq 128), density 0.25] $ s "<gabba:2(3, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(4, 6, 2)>"
    # gain 0.8
    # room 0.7
    # freq 900
    # cutoff 900
    # hcutoff 500
  l1 $ slowcat [
        s "<outdoor:1*2, 909:2*2> outdoor:1 ~" # gain 0.8,
        s "outdoor:1 outdoor:1 ~" # gain 0.9,
        s "<outdoor:1, 909:2*2> outdoor:1 ~" # gain 0.5
    ]
    # gain 0.8 # cutoff 1000 # room 2 # dry 0.4
  l2 $ layer[id, density 0.5 . striate 2 . slow 4 . (# freq 120)] $ slowcat
    [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3*4>" # gain 0.6,
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.5
    ] # cutoff 1500
    # gain 0.79
  l3 $ density 0.5 $ layer [ghost, slow 12] $ struct "1 [1 1] 0 [1 1 0 0]" $ interlace (s "bd ~ [bd:2 ~ ~ <outdoor:4, ed0:1> ~ ~] ~ [bd ~ ~ [<ed0:1, outdoor:4> ~ [outdoor:4 ~ ~] bd:2]]") (s "bd:3 ~ bd <bd:3, bd:2*2>")
    # pan "0.1 0.3 0.35 0.5 0.6 0.65 0.8 0.9 0.85 0.6" # gain 0.9 # cutoff 500
  b5 $ density 1 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(2, 6, 2)>" # cutoff 200
  b2 $ layer[density 0.5, density 0.125, density 2]
    $ s "<gabba:2(3, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(4, 6, 2)>"
    # gain 0.7
    # room 0.6
    # freq 300
    # cutoff 600
    # stretch 0.9
  l4 $ silence

do
  -- glacial ray
  l4 $ struct "[1 0 0] 0 [1 0 1] 1" $ layer[stut 8 0.2 0.1 . (#freq 6000), striate 2 . density 0.5 . every 4 (fast 2  . (# distort saw) ) . (#amp 0.8) . (# hcutoff 400)] $ slowcat [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3>" # gain 0.6,
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.5 # freq 100
    ]
    # cutoff 3400
    # freq 7058
    # hcutoff 680
    # stretch 0.3
    # gain 0.4
    # room 1
    # overgain 0.3
    # delay 0.5

do
  -- electric
  l6 $ layer[density 0.5, striate 2, every 8 (# distort saw)] $ slowcat [
      s "<derr:2(6, 12, 2), derr:3*2, derr:5(4, 16, 8)>" # freq 512 # higher 2 # room 0.25,
      layer[stut 2 0.2 0.8, density 0.5, slow 4] $ s "~ ~ <derr:2(3, 8, 2), derr:3*2, derr:5(2, 8)>" # freq 1024 # higher 4 # room 0.5,
      density 4 $ s "<derr:2(3, 8, 2), derr:5(2, 8)> [derr:5 ~ ] ~ " # freq 512 # legato 0.5 # higher 2 # room 0.5
    ] # higher 1 # gain 0.7 # freq 200 # hcutoff 1000 # resonance 0.4 # attack 0.03


do -- opening
  --d6 $ slow 4 $ s "[~ ed0:3] [bass0:3 ~ <bass0:3 909:3> [bass0:3 ~ <bass0:2 909:3> ~]]/4 bass0:2 techno:6 ~" # cutoff (range 500 5000 $ cF 0.8 "12")
  b1 $ density 0.25 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(2, 6, 2)>"
  --let patt = "<[sd:3 sd:4], [sd:2 sd:2 sd:4 sd:2]> <[sd <uxay:3, bd:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, bd:2*2>]"
  let patt = "<[ed0:3 [ed0:4 ~ uxay:9 [ed0:4 ed0:4]]], [ed0:1 [ed0:1(8, 16)]]> ed0:1 [ed0:6 [ed0:8 cre:12]]" -- <[sd <uxay:3, ed0:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, ed0:2*2>]"
  let shape = "1 [1 ~ 1] [1 1] [1 0 0 1]"
  b2 $ layer[density 0.5, density 0.125] $ every 16 (stutter 2 0.2) $ struct shape $ s patt # cutoff 3500 # gain 1 # gain 0.85
  -- glacial
  l1 $ struct "[1 1 0] 1 [1 1 1] 1" $ layer[slow 1, (#freq 4000), density 0.5] $ slowcat [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3*4>" # gain 0.6,
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.5
    ]
    # freq 2580
    # stretch 0.2
    # gain 0.6
    # room 3
  -- electric
  l2 $ layer[density 0.5, striate 2] $ slowcat [
      s "<derr:2(6, 12, 2), derr:3*2, derr:5(4, 16, 8)>" # freq 512 # higher 2 # room 0.25,
      layer[stut 2 0.2 0.8, density 0.5, slow 4] $ s "~ ~ <derr:2(3, 8, 2), derr:3*2, derr:5(2, 8)>" # freq 1024 # higher 4 # room 0.5,
      density 4 $ s "<derr:2(3, 8, 2), derr:5(2, 8)> [derr:5 ~ ] ~ " # freq 512 # legato 0.5 # higher 2 # room 0.5
    ] # higher 1 # gain 0.4 # freq 200

do
  --d6 $ slow 4 $ s "[~ ed0:3] [bass0:3 ~ <bass0:3 909:3> [bass0:3 ~ <bass0:2 909:3> ~]]/4 bass0:2 techno:6 ~" # cutoff (range 500 5000 $ cF 0.8 "12")
  -- b3 $ density 0.25 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, [bd:4(6, 8, 2)]/2, gabba:4(2, 6, 2)>" # cutoff 120 # room 0.95 # resonance 0.04 # overgain 0.1
  -- b1 $ density 0.25 $ s "<909:4(4, 8), [~ ~ ~ 909:4(6, 6, 2)], bd:4(3,8), gabba:4(2, 6, 2)>" # hcutoff 800 # cutoff 400 # room 0.2 # gain 0.8
  --let patt = "<[sd:3 sd:4], [sd:2 sd:2 sd:4 sd:2]> <[sd <uxay:3, bd:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, bd:2*2>]"
  let patt = "<[ed0:3 [ed0:4 ~ uxay:9 [ed0:4 ed0:4]]], [ed0:1 [ed0:1(8, 16)]]> ed0:1 [ed0:6 [ed0:8 cre:12]]" -- <[sd <uxay:3, ed0:2*2> sd:2 uxay:3*2], [~ uxay:2]> [sd:9 ~ <techno:2, ed0:2*2>]"
  let shape = "1 [1 ~ 1] [1 1] [1 0 0 1]"
  --b2 $ layer[density 0.5, density 0.125] $ every 16 (stutter 2 0.2) $ struct shape $ s patt # cutoff 3500 # gain 1 # gain 0.85 # nudge 4
  -- heart
  l3 $ every 4 (density 2 . (#attack 0.8) ) $ density 0.125 $ layer [every 8 (stut 2 0.5 0.5 . density 2), id, slow 8, fast 2] $ slowcat [
      s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>",
      stack [
        s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        s "~ ~ ~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      stack [
        s "<outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      stack [
        slow 2 $ s "~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>",
        s "~ ~ ~ <outdoor:1*2, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3, uxay:7*2>"
        ],
      s "<outdoor:1, bd:2*4> <outdoor:2*4, bd*2> <outdoor:3, bd:3*2, uxay:7>",
      s "<outdoor:1, bd:2*4> <outdoor:2, gabba:4*2> <outdoor:3, bd:3>"
    ] # gain 0.7 # stretch 0.8 # room 0.6 # cutoff 2000 # begin (slow 13 $ range 0 0.9 sine) # sustain 4 # cut 3

hush

do -- the good one - bum pa bum bum bum
  b1 $ layer[density 0.5, density 0.125, density 2] $ s "<gabba:2(3, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(4, 6, 2)>"
    # gain 0.75
    # room 1
    # freq 305
    # cutoff 800
    # hcutoff 20
    # overgain 0.232
  l5 $ slowcat [
        s "<outdoor:1*2, 909:2*2> outdoor:1 ~" # gain 0.8,
        s "outdoor:1 outdoor:1 ~" # gain 0.9,
        s "<outdoor:1, 909:2*2> outdoor:1 ~" # gain 0.5
    ]
    # gain 0.75 # cutoff 200 # overgain 0.1 # room 1 # dry 0.4
  l2 $ slowcat [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3*4>" # gain 0.6,
        s "<outdoor:1, bd:2*4> <outdoor:2*2, bd*2> <outdoor:3, bd:3>" # gain 0.9,
        s "<outdoor:1, bd:2*2> <outdoor:2*4, bd> <outdoor:3, bd:3*2>" # gain 0.5
    ]
    # gain 0.79 # cutoff 1000 # overgain 0.1
  l3 $ density 0.125 $ layer [ghost, slow 12] $ struct "1 [1 0] 0 [1 0 ~ 1]" $ interlace (s "bd ~ [bd:2 ~ ~ <outdoor:4, ed0:1> ~ ~] ~ [bd ~ ~ [<ed0:1, outdoor:4> ~ [outdoor:4 ~ ~] bd:2]]") (s "bd:3 ~ bd <bd:3, bd:2*2>")
    # pan "0.1 0.3 0.35 0.5 0.6 0.65 0.8 0.9 0.85 0.6" # gain 0.6 # cutoff 500
  b3 $ density 0.5 $ s "<gabba:2(6, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(2, 6, 2)>" # overgain 0.2 # cutoff 60
  b2 $ layer[density 0.5, density 0.125, density 2] $ s "<gabba:2(3, 6, 2), 909:4(4, 8), outdoor:5/4, bd:4(3,8), gabba:4(4, 6, 2)>"
    # gain 0.75
    # room 0.7
    # overgain 0.1
    # freq 300
    # cutoff 2000
  b5 $ silence
  b6 $ silence
  l1 $ slowcat [
        s "<outdoor:1*2, 909:2*2> outdoor:1 ~" # gain 0.8,
        s "outdoor:1 outdoor:1 ~" # gain 0.9,
        s "<outdoor:1, 909:2*2> outdoor:1 ~" # gain 0.5
    ]
    # gain 0.8 # cutoff 2000 # room 2 # dry 0.4
  l6 $ slowcat [
        s "<outdoor:1*2, bd:2*2> <outdoor:2, bd*4> <outdoor:3, bd:3*4>" # gain 0.6,
