do
  hush
  resetCycles

do
  -- setBaseline
  setcps(80/60/4)
  l1 $ layer[id, (#freq 60) . (# amp 0.3) . (# cutoff 100), density 0.5] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.85,
          s "bd" # gain 0.85
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.6,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.85 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.8 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.8
        ]
      ] # stretch 0.8
    ]

a1 $ density 0.25 $ layer[slow 2, density 0.5 . (#freq 60) . (# amp 0.3) . (# cutoff 100), density 0.25] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          density 0.25 $ n (run 6) # s "exxo" # gain 0.55,
          s "exxo" # gain 0.65
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 4 $ slowcat [
        stack [
          density 0.25 $ n (run 6) # s "exxo" # gain 0.4,
          every 4 (density 2) $ n (run 2) # s "~ [exxo:2 ~] ~" # gain 0.85 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "exxo:4" # freq 512 # gain 0.8 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.4
        ]
      ] # stretch 0.7
    ] # begin (slow 13 $ range 0 0.9 sine) # sustain 2


let gentle = layer[density 1, density 0.125, (# freq 128), (# freq 256), (# freq 512)]

-- NOPE
-- 8% - gentler this time
a3 $ layer[density 2, density 0.125, (# freq 128), (# freq 256), (# freq 512)] $ stack [
    density 0.5 $ striate 4 $ slowcat [
      stack [
        n (run 6) # s "[bd bd]" # gain 1,
        striate 2 $ n (run 3) # s "[~ [vt]]" # gain 0.8 # freq 128
      ]
    ] # stretch 0.8
  ] # freq 972 # cutoff 4000 # legato 2 # speed 1 # stretch 0.11 # gain 0.8
-- l2 $ silence

unsoloAll

a3 $ silence

do
  -- @10
  l3 $ struct "1 0 [ 1 1 ] 0" $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        fast 2 $ stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        fast 2 $ stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.75

do -- @10
  l4 $ layer [ id . (# freq 260) . (# amp 0.3), density 0.5, every 6 (slow 2) . (#freq 260) . (# amp 0.3)] $ stack [
    density 0.25 $ layer [striate 2, striate 4] $ slowcat [
      stack [
        n (run 6) # s "vt" # gain 0.7,
        s "bd" # gain 0.7
      ] # stretch 0.4
    ] # room 1,
    density 0.25 $ striate 4 $ slowcat [
      slow 2 $ stack [
        n (run 6) # s "vt" # gain 0.6,
        every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
        stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.75 # cutoff 1000 # dry 0.1,
        n (run 8) # s "gra" # gain 0.6
      ]
    ] # stretch 0.8,
    density 0.5 $ every 4 (striate 2) $ n (run 6) # s "vt" # gain 0.6 # speed 2 # legato 2 # attack 0.5
    ] # gain 0.66

do
  -- @10
  l6 $ every 8 (# distort 0.2) $ stack [
    density 0.5 $ layer [striate 2] $ slowcat [
      stack [
        n (run 4) # s "[vt vt ~ [~ vt]]" # gain 0.9 # stretch 0.8 # room 0.9,
        density 1 $ fast 2 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.2 # room 1 # dry 0.5
      ] # freq 400,
      s "~",
      fast 2 $ stack [
        n (run 6) # s "[vt vt ~ vt]" # gain 0.9 # stretch 0.8 # room 0.9,
        every 2 (density 2) $ fast 1 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.3 # room 1 # dry 0.5
      ] # freq 200
    ],
    density 0.25 $ striate 4 $ slowcat [
      stack [
        n (run 6) # s "[vt vt] [[vt [vt ~]] vt]" # gain 0.8
      ]
    ] # stretch 0.8
  ] # cutoff 6000 # gain 0.5

do
  -- @10
  l5 $ layer[struct "1 0 [ 1 1 ] 0", density 0.25 . (#delay 0.25) . (# hcutoff 500)] $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.35 # nudge 4 # cutoff 700 # legato 0.3 # begin (slow 13 $ range 0 0.9 sine) # sustain 2


do
  -- @20
  l3 $ struct "1 0 [ 1 1 ] 0" $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.65

do
  -- @10
  l3 $ struct "1 0 [ 1 1 ] 0" $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.65

do -- @20
  l6 $ layer [ (#freq 60) . (# amp 0.3), density 0.5] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.7,
          s "bd" # gain 0.7
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.6,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.75 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.6
        ]
      ] # stretch 0.8,
      density 0.5 $ every 4 (striate 2) $ n (run 6) # s "vt" # gain 0.6 # speed 2 # legato 2 # attack 0.5
    ] # gain 0.66 |+| 0.01

do -- CROWN
  l3 $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 4) # s "[vt vt ~ [~ vt]]" # gain 0.9 # stretch 0.8 # room 0.9,
          density 1 $ fast 2 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.2 # room 1 # dry 0.5
        ] # freq 400,
        s "~",
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.9 # stretch 0.8 # room 0.9,
          every 2 (density 2) $ fast 1 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.3 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt] [[vt [vt ~]] vt]" # gain 0.8
        ]
      ] # stretch 0.8
    ] # cutoff 6000

do -- 8%
  l4 $ layer[struct "1 0 [ 1 1 ] 0", density 0.25 . (#delay 0.25) . (# hcutoff 500)] $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.65 # nudge 4 # cutoff 7000 # legato 0.3

do -- sooner
  l1 $ layer [ (#freq 260) . (# amp 0.3), density 0.5, every 6 . (#freq 260) . (# amp 0.3)] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.7,
          s "bd" # gain 0.7
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.6,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.75 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.6
        ]
      ] # stretch 0.8,
      density 0.5 $ every 4 (striate 2) $ n (run 6) # s "vt" # gain 0.6 # speed 2 # legato 2 # attack 0.5
    ] # gain 0.66 |+| 0.01
  -- 8%
  l3 $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 4) # s "[vt vt ~ [~ vt]]" # gain 0.9 # stretch 0.8 # room 0.9,
          density 1 $ fast 2 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.2 # room 1 # dry 0.5
        ] # freq 400,
        s "~",
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.9 # stretch 0.8 # room 0.9,
          every 2 (density 2) $ fast 1 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1.3 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt] [[vt [vt ~]] vt]" # gain 0.8
        ]
      ] # stretch 0.8
    ] # cutoff 6000

do -- 8%
  l6 $ layer[struct "1 0 [ 1 1 ] 0", density 0.25 . (#delay 0.25) . (# hcutoff 500)] $ every 8 (# distort 0.2) $ stack [
      density 0.5 $ layer [striate 2] $ slowcat [
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.75 # stretch 0.8 # room 1,
          density 0.5 $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 1 # room 1.5 # dry 0.5
        ] # freq 100,
        stack [
          n (run 6) # s "[vt vt ~ vt]" # gain 0.8 # stretch 0.8 # room 1,
          every 2 (density 2) $ fast 4 $ s "[vt vt ~ vt]" # gain 0.7 # stretch 2 # room 1 # dry 0.5
        ] # freq 200
      ],
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "[vt vt]" # gain 0.75
        ] # freq 400
      ] # stretch 0.8
    ] # gain 0.65 # nudge 4 # cutoff 7000 # legato 0.3

do
  l3 $ slow 2 $ layer [slow 16, striate 4, density 0.5 . (#freq 256), rev . (#freq 128)]
    $ density 0.5 $ n (run 6) # s "[vt [vt vt] ~ vt]"
    # gain 0.6 # stretch 0.5 # room 0.9 # delay 0.1 # decay 0.6 # lfo 0.2 # pan sine
    # dry 0.3 # gain 0.6 # distort 0.1 # resonance 0.4 # hcutoff 100
    -- 8% -- pulsating
  l5 $ density 0.5 $ layer [striate 2, striate 4] $ slowcat [
      stack [
        n (run 6) # s "vt",
        density 0.5 $ striate 2 $ s "[vt vt ~ [vt vt ~ [vt vt ~ vt]]]" # freq 520 # decay 0.8,
        s "bd*12" # gain 0.75
      ] # stretch 0.4,
      n (run 6) # s "vt" # stretch 0.4
    ] # room 0.4 # amp 0.3 # hcutoff 80
  l2 $ (#freq 60) . (# amp 0.3) $ stack [
      density 0.25 $ layer [striate 2, fast 2 . slow 2 . striate 2] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.7,
          s "bd" # gain 0.7
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.6,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.75 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.6
        ]
      ] # stretch 0.8
    ] # gain 0.56 |+| 0.01

do
  -- the one
  b3 $ density 0.125 $ every 2 (# gain 2) $ layer[density 2, fast 4 . density 0.5 . (# cutoff 500)] $ layer [
      (#nudge 4) . density 1 . (#stretch 0.4) . (#freq 1000),
      density 2 . (#degrade 2) . (#stretch 0.18) . (# freq 480) . (#cutoff 7800) . (#hcutoff 2080),
      (#nudge 8) . every 4 (slow 4) . every 3 (slow 2) . slow 2 . (#freq 1240) . (#overgain 0.025) . fast 2 . (striate 2) . (#cutoff 1960) . (#hcutoff 160)
    ] $ stack [
    slow 2 $ s "<gabba:3*2, [bend:2(6, 12, 3)]/2, haw:6*4, 909:4(3, 12), bd:4*2>",
    slow 4 $ s "<gabba:3*3, [bend:8(12, 12, 3)]/2, haw:4(6,4), 909:4(6, 12), bd:4(4, 8)>",
    fast 2 $ s "<gabba:3*4, [bend:8(6, 12, 3)]/2, haw:4*4, 909:4(3, 12), bd:4*2>"
    ]
    # cutoff 2800
    # gain 0.7

do
  -- the one
  b1 $ density 0.25 $ every 2 (# gain 2) $ layer[density 2, fast 4 . density 0.5 . (# cutoff 500)] $ layer [
      (#nudge 4) . density 1 . (#stretch 0.4) . (#freq 1000),
      density 2 . (#degrade 2) . (#stretch 0.18) . (# freq 3480) . (#cutoff 7800) . (#hcutoff 2080),
      (#nudge 8) . every 4 (slow 4) . every 3 (slow 2) . slow 2 . (#freq 1240) . (#overgain 0.025) . fast 2 . (striate 2) . (#cutoff 1960) . (#hcutoff 160)
    ] $ slowcat [
    s "<gabba:3*2, [bend:2(6, 12, 3)]/2, haw:6*4, 909:4(3, 12), bd:4*2>",
    fast 2 $ s "<gabba:3*3, [bend:8(12, 12, 3)]/2, haw:4(6,4), 909:4(6, 12), bd:4(4, 8)>",
    s "<~, [bend:8(6, 12, 3)]/2, haw:4*4, 909:4(3, 12), bd:4*2>"
    ]
    # cutoff 600 # dry 0.4 # release 0.8 # attack 0.12
    # gain 0.15

hush


-- 8%
a1 $ every 8 (layer[density 0.25, density 0.5 . (# stretch 0.4)])
  $ density 0.5 $ layer[striate 2, density 4 . (#freq 128)]
  $ s "~ ~ ~ exxo:1"
  # stretch 0.8
  # legato 4
  # resonance 0.4
  # attack 0.1
  # dry 0.3
  # room 0.6

hush




unsoloAll

-- 8%
b2 $ every 4 (fast 4) $ striate 2 $ stack [
  layer[every 8 (density 2), slow 4, density 0.1] $ striate 2 $ slowcat [
    stack [
      n (run 6) # s "[bd bd bd bd]" # gain 1 # freq 420,
      striate 2 $ n (run 3) # s "[vt ~ [vt vt] ~]" # gain 0.8 # freq 128
    ]
  ] # stretch 0.8
] # gain 0.8 # hcutoff 200 # fshift 400 # attack 0.4 # legato 2

hush

solo 11
solo 2
solo 10
solo 11

do -- POP
  -- 9%
  b2 $ silence
  b1 $ layer[density 1, density 0.125 . (# fshift 20)] $ stack [
      layer [( # stretch (range 1.3 1.5 $ sine*8) ), density 0.125]
        $ s "<{gabba:4*8}?, gabba:2*6,techno:1(8, 8, 3), techno:1(3, 8), techno:4(3, 8, 1), techno:1(4, 16, 2), techno:6>",
      every 16 (density 1) $ density 0.125 $ layer [(#freq 290), (#freq 5000)]
        $ iter 2 $ s "<909:6*6(2, 8, 3), gabba:4*2, techno:2(2, 8, 1), techno:1(3, 8), techno:4(3, 8, 1), bend:1*4(4, 16, 2)>"
    ] # hcutoff 50 # amp 0.7 # cutoff 320 # room 0.6 # gain 0.6 # overgain 0.2
  l1 $ layer [id, (#freq 100), density 0.25 . (# freq 90) . (# hcutoff 100) . (# delay 0.01)] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.7,
          s "bd" # gain 0.8
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 4 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.66,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.8 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.6
        ]
      ] # stretch 0.8
    ] # gain 0.75 # cutoff 1800
  b3 $ fast 2 $ s "<{gabba:4}, gabba:2*6, techno:1(3, 8, 3), techno:1(3, 8), techno:4(3, 8, 1), techno:1(4, 16, 2), techno:6>"
    # nudge 3 # freq 90 # cutoff 300

do -- POP
  -- 9%
  b4 $ layer[density 1, density 0.125 . (# fshift 20)] $ stack [
      layer [( # stretch (range 1.3 1.5 $ sine) ), density 0.125]
        $ s "<{gabba:4*8}?, gabba:2*6,techno:1(8, 8, 3), techno:1(3, 8), techno:4(3, 8, 1), techno:1(4, 16, 2), techno:6>",
      every 16 (density 1) $ density 0.125 $ layer [(#freq 290), (#freq 5000)]
        $ iter 2 $ s "<909:6*6(2, 8, 3), gabba:4*2, techno:2(2, 8, 1), techno:1(3, 8), techno:4(3, 8, 1), bend:1*4(4, 16, 2)>"
    ] # hcutoff 50 # amp 0.7 # cutoff 3200 # room 0.6 # gain 0.6 # overgain 0.01
  l1 $ layer [id, (#freq 100), density 0.25 . (# freq 90) . (# hcutoff 100) . (# delay 0.01)] $ stack [
      density 0.25 $ layer [striate 2, striate 4] $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.7,
          s "bd" # gain 0.8
        ] # stretch 0.4
      ] # room 1,
      density 0.25 $ striate 2 $ slowcat [
        stack [
          n (run 6) # s "vt" # gain 0.66,
          every 4 (density 2) $ n (run 2) # s "~ [cre ~] ~" # gain 0.6 # stretch 1,
          stut 3 0.3 0.1 $ n (run 4) # s "derr" # freq 512 # gain 0.8 # cutoff 1500 # dry 0.1,
          n (run 8) # s "gra" # gain 0.6
        ]
      ] # stretch 0.8
    ] # gain 0.65 # cutoff 180
  b3 $ fast 2 $ s "<{gabba:4}, gabba:2*6, techno:1(3, 8, 3), techno:1(3, 8), techno:4(3, 8, 1), techno:1(4, 16, 2), techno:6>"
    # nudge 3 # freq 90 # cutoff 30 # gain 0.6

do
  b5 $ layer[density 0.5, density 0.125 . (# fshift 20)] $ stack [
        layer [density 0.25, slow 2]
          $ s "<{gabba:4*8}?, gabba:2*6,techno:1(8, 8, 3), techno:1(3, 8), techno:4(3, 8, 1), techno:1(4, 16, 2), techno:6>*2",
        every 16 (density 1) $ density 0.5 $ layer [(#freq 290), (#freq 5000)]
          $ iter 2 $ s "<909:6*6(2, 8, 3), gabba:4*2, techno:2(2, 8, 1), techno:1(3, 8), techno:4(3, 8, 1), bend:1*4(4, 16, 2)>"
      ] # hcutoff 50 # amp 0.7 # cutoff 3200 # room 0.6 # gain 0.6 # overgain 0.01

hush

l4 $ silence

do
  -- 10%
  l6 $ slow 4 $ layer[density 2, density 0.5] $ every 8 (striate 4) . (#freq 200) . (# release 2) $ slowcat [
    stack [
      n (run 6) # s "vt",
      every 4 (density 2) $ n (run 2) # s "cre" # gain "0.6" # stretch 1,
      n (run 4) # s "derr" # freq 512,
      n (run 8) # s "gra" # gain "0.6"
    ]
  ] # stretch 0.4 # gain 0.15 # cutoff 500

do
  -- 6%
  b4 $ layer[slow 4 . striate 2 . (#freq 128), density 0.25 . (# 200), density 0.5 . (#freq 100)]
    $ layer [density 2 . (# freq 24), slow 2 . (# freq 128), slow 2 . (# freq 72)] $ stack [
      slowcat [
          s "~ gabba:4*6" # pan cosine # freq 400,
          s "gabba:4*6" # pan cosine # freq 200,
          stack [
            s "gabba:4*6" # pan cosine # freq 300,
            s " ~ ~ gabba:4*2" # pan cosine # freq 2000 # hcutoff 600
          ],
          s "~ ~ gabba:4*2" # pan cosine # freq 400
        ] # gain 1,
        s "~ ~ gabba:4(4, 8, 2)" # pan cosine # freq 300
      ]
      # cutoff 9800 |+| 100
      # fshift 10
      # room 0.6
      # dry 0.2
      # hcutoff 1200
      # degrade 0.8
      # stretch 0.2
      # gain 0.6
  -- 6%
  b3 $ struct "0 1 1 0 0 1 1 0 0 " $ density 0.125 $ layer[slow 4 . striate 4 . (#freq 128), density 0.25 . (#freq 200), density 0.5 . (#freq 100)]
    $ layer [density 1 . (# freq 24), slow 2 . (# freq 128), slow 2 . (# freq 72)] $ stack [
      slowcat [
